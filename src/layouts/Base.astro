---
import '../styles/global.css';
import { SITE, SHIPPING } from '../data/site.js';
import { CATEGORIES, LAUNCH_OFFER, launchOfferActive } from '../data/catalog.js';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: string;
  jsonld?: object | object[];
  preload?: { href: string; imagesrcset?: string; imagesizes?: string; media?: string }[];
}
const { title, description, image, canonical, noindex = false, type = 'website', jsonld, preload = [] } = Astro.props;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image ?? '/img/home/hero-1200.jpg', SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const path = Astro.url.pathname;
const nav = [
  { href: '/men/polo-shirts/', label: 'Polos' },
  { href: '/unisex/hoodies/', label: 'Hoodies' },
  { href: '/unisex/sweatshirts/', label: 'Sweatshirts' },
  { href: '/women/', label: 'Women' },
  { href: '/bundles/', label: 'Sets & Bundles' },
];
---
<!doctype html>
<html lang="en-PK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1d1b18" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_PK" />
    <meta name="twitter:card" content="summary_large_image" />
    {preload.map((p) => <link rel="preload" as="image" href={p.href} imagesrcset={p.imagesrcset} imagesizes={p.imagesizes} media={p.media} fetchpriority="high" />)}
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {launchOfferActive() && <a class="announce announce-launch" href="/bundles/" data-ends={LAUNCH_OFFER.ends}>{LAUNCH_OFFER.blurb} · Applied automatically at checkout</a>}
    {launchOfferActive() && <script is:inline>(function(){var a=document.querySelector('.announce-launch');if(a&&Date.now()>Date.parse(a.dataset.ends))a.remove();})();</script>}
    <div class="announce">Free delivery over Rs {SHIPPING.freeThreshold.toLocaleString('en-PK')} · Cash on delivery across Pakistan · {SHIPPING.exchangeDays}-day size exchange</div>
    <header class="header">
      <div class="wrap header-in">
        <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <nav class="nav" aria-label="Main">
          {nav.slice(0, 3).map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a href="/" class="logo" aria-label={`${SITE.name} home`}>Herre<span>&amp;</span>Dame</a>
        <div class="header-actions">
          <nav class="nav" aria-label="More">
            {nav.slice(3).map((n) => <a href={n.href}>{n.label}</a>)}
          </nav>
          <a href="/cart/" class="cart-link" aria-label="Cart">Bag <span class="cart-count" data-cart-count>0</span></a>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/men/">Men</a>
        <a href="/accessories/">Accessories</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a href="/" class="logo">Herre<span>&amp;</span>Dame</a>
            <p>{SITE.tagline}</p>
            <p>Herre &amp; Dame is Danish for "gentlemen &amp; ladies". We make matching pieces for both.</p>
          </div>
          <div>
            <h3>Shop</h3>
            <ul>
              {CATEGORIES.map((c) => <li><a href={c.path}>{c.h1}</a></li>)}
              <li><a href="/bundles/">Sets &amp; Bundles</a></li>
            </ul>
          </div>
          <div>
            <h3>Help</h3>
            <ul>
              <li><a href="/shipping-and-exchanges/">Delivery &amp; exchanges</a></li>
              <li><a href="/size-guide/">Size guide</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy</a></li>
            </ul>
          </div>
          <div>
            <h3>Talk to us</h3>
            <ul>
              <li><a href={`https://wa.me/${SITE.whatsapp}`} rel="noopener">WhatsApp</a></li>
              <li><a href={SITE.instagram} rel="noopener">Instagram</a></li>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <span>© {new Date().getFullYear()} {SITE.name}. Made in Pakistan.</span>
          <span>Cash on delivery · Prices in PKR</span>
        </div>
      </div>
    </footer>

    <a class="wa-float" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hi Herre&Dame, I have a question')}`} aria-label="Chat on WhatsApp" rel="noopener">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.9-3.9-1.9-6 0-5.9 4.9-10.7 11-10.7s11 4.8 11 10.7-4.9 10.9-10.9 10.9zm6-8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1c-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2s0-.5.1-.6l.5-.6c.2-.2.2-.4.3-.6s0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.1-1.2 2.7 1.2 3.1 1.4 3.3 2.4 3.6 5.7 5c.8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5s-.3-.2-.6-.4z"/></svg>
    </a>
    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      import { cartCount } from '../scripts/cart-store.js';
      const update = () => document.querySelectorAll('[data-cart-count]').forEach((el) => (el.textContent = String(cartCount())));
      update();
      window.addEventListener('cart:change', update);
      window.addEventListener('storage', update);
      const t = document.querySelector('.menu-toggle');
      const m = document.getElementById('mobile-nav');
      t?.addEventListener('click', () => {
        const open = t.getAttribute('aria-expanded') !== 'true';
        t.setAttribute('aria-expanded', String(open));
        m?.setAttribute('data-open', String(open));
      });
    </script>
  </body>
</html>
