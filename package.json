{
  "name": "herre-dame-store",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "images": "node scripts/import-images.mjs",
    "dev:full": "astro build && wrangler pages dev dist",
    "db:local": "wrangler d1 execute herre-dame-orders --local --file=schema.sql",
    "db:remote": "wrangler d1 execute herre-dame-orders --remote --file=schema.sql"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "^5.18.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=20"
  }
}